# Address of the FlowTask API the app talks to. On a phone in development use your computer's LAN
# address (e.g. http://192.168.1.20:4000), not localhost. People can also change it on the sign-in screen.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Browser tests (npm run test:e2e): the e2e runner recreates this database and starts the API on it.
E2E_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
E2E_DATABASE=flowtask_e2e
# Port of the static server for the web build used by the browser tests.
PORT=8199
