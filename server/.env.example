# FlowTask API configuration. Every value has a development default.

DATABASE_URL=postgres://postgres:postgres@localhost:5432/flowtask
DATABASE_POOL=10
PORT=4000
HOST=0.0.0.0
# Comma-separated origins allowed to call the API from a browser (the web build). Phones don't need this.
CORS_ORIGINS=http://localhost:8081
# true when running behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
SESSION_DAYS=60
SIGNUPS_PER_HOUR=10
LOG_LEVEL=info

# Push notifications through Expo's push service
PUSH_ENABLED=true
EXPO_PUSH_URL=https://exp.host/--/api/v2/push/send
# Optional: an Expo access token if "enhanced push security" is on for your project
EXPO_ACCESS_TOKEN=
# Background work (push sending, clean-up). Safe on every instance.
WORKERS=true

# Tests
TEST_ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
TEST_DATABASE=flowtask_test
